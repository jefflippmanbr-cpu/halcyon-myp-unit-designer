ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Local dev only. Leave this UNSET when deploying — hosts inject their own PORT.
API_PORT=8787

# Shared staff password gate. Leave APP_PASSWORD unset to run fully open (local dev).
APP_PASSWORD=change-me-before-sharing
# Signs session tokens. Set this in production or a restart logs everyone out.
SESSION_SECRET=
SESSION_HOURS=168
